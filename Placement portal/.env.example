# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: pin a Groq model (otherwise one is picked automatically)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional fallback, used only if GROQ_API_KEY is empty
# HF_TOKEN=hf_your_token_here
