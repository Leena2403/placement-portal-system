# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: pin a Groq model (otherwise one is picked automatically)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional fallback, used only if GROQ_API_KEY is empty
# HF_TOKEN=hf_your_token_here

# --- Email ---
# By default all email goes to Mailpit (local test inbox at http://localhost:8025).
# Uncomment these only to send REAL email through Gmail (needs a Gmail App Password).
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USE_SSL=true
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-gmail-app-password
# MAIL_SENDER=your@gmail.com
